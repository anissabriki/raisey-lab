# generated / local
dist/
__pycache__/
*.pyc
.DS_Store
# never commit secrets or local environment files
.env
.env.*
*.pem
*.key
node_modules/
email/preview/

# Cloudflare Worker local files (may hold test secrets)
.dev.vars
.wrangler/
worker/.dev.vars
worker/.wrangler/

# never commit backups/archives or editor/OS/local tooling files
_ARCHIVE*/
*.bak
*.zip
*.log
*.swp
.vscode/
.idea/
.claude/
Thumbs.db
# credentials that tools sometimes write locally
.npmrc
*.p12
secrets*
credentials*
